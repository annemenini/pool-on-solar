{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "fluid": true,
  "functions": {
    "api/web.py": {
      "maxDuration": 60,
      "excludeFiles": "{tests/**,scripts/**}"
    },
    "api/jobs/automation.py": {
      "maxDuration": 120,
      "experimentalTriggers": [
        {
          "type": "schedule/v1beta"
        }
      ],
      "excludeFiles": "{tests/**,scripts/**}"
    },
    "api/jobs/analysis.py": {
      "maxDuration": 180,
      "experimentalTriggers": [
        {
          "type": "schedule/v1beta"
        }
      ],
      "excludeFiles": "{tests/**,scripts/**}"
    }
  },
  "schedules": {
    "pool-on-solar": {
      "schedule": "*/15 * * * *",
      "timezone": "America/Los_Angeles",
      "function": "api/jobs/automation"
    },
    "pool-on-solar-analysis": {
      "schedule": "0 4 * * *",
      "timezone": "America/Los_Angeles",
      "function": "api/jobs/analysis"
    }
  },
  "rewrites": [
    {
      "source": "/.well-known/appspecific/com.tesla.3p.public-key.pem",
      "destination": "/api/web"
    },
    {
      "source": "/api/status",
      "destination": "/api/web"
    },
    {
      "source": "/scheduler/:action",
      "destination": "/api/web"
    },
    {
      "source": "/oauth",
      "destination": "/api/web"
    },
    {
      "source": "/oauth/:action*",
      "destination": "/api/web"
    },
    {
      "source": "/healthz",
      "destination": "/api/web"
    },
    {
      "source": "/",
      "destination": "/api/web"
    }
  ]
}
