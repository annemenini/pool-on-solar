{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "fluid": true,
  "functions": {
    "api/web.py": {
      "maxDuration": 30
    }
  },
  "schedules": {
    "pool-on-solar": {
      "root": ".",
      "entrypoint": "jobs"
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/web"
    },
    {
      "source": "/healthz",
      "destination": "/api/web"
    },
    {
      "source": "/api/status",
      "destination": "/api/web"
    },
    {
      "source": "/scheduler/(.*)",
      "destination": "/api/web"
    },
    {
      "source": "/oauth",
      "destination": "/api/web"
    },
    {
      "source": "/oauth/(.*)",
      "destination": "/api/web"
    },
    {
      "source": "/.well-known/appspecific/com.tesla.3p.public-key.pem",
      "destination": "/api/web"
    }
  ]
}
